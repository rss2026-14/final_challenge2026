<launch>
    <node pkg="final_challenge" exec="boating_executive" name="boating_executive" output="screen">
        <param name="skip_parking_at_last_goal" value="true" />
    </node>

    <node pkg="path_planning" exec="trajectory_planner" name="trajectory_planner" output="screen">
        <param from="$(find-pkg-share path_planning)/config/real/config.yaml"/>
        <remap from="/goal_pose" to="/planner/goal"/>
    </node>

    <node pkg="path_planning" exec="trajectory_follower" name="trajectory_follower" output="screen">
        <param from="$(find-pkg-share path_planning)/config/real/config.yaml"/>
        <param name="drive_topic" value="/vesc/high_level/input/nav_0" />
    </node>

    <node pkg="localization" exec="particle_filter" name="particle_filter" output="screen">
        <param from="$(find-pkg-share path_planning)/config/real/pf_config.yaml"/>
    </node>

    <node pkg="lab03" exec="safety_stop" name="safety_stop" output="screen">
        <param from="$(find-pkg-share path_planning)/config/real/config.yaml"/>
    </node>

    <node pkg="final_challenge" name="parking_meter_controller" exec="parking_meter_controller" output="screen">
        <param name="drive_topic" value="/vesc/high_level/input/nav_0" />
    </node>

    <node pkg="final_challenge" name="meter_search_controller" exec="meter_search_controller" output="screen">
        <param name="drive_topic" value="/vesc/high_level/input/nav_0" />
        <param name="scan_topic" value="/scan" />
    </node>

    <node pkg="final_challenge" name="reverse_controller" exec="reverse_controller" output="screen">
        <param name="drive_topic" value="/vesc/high_level/input/nav_0" />
    </node>

    <node pkg="final_challenge" name="homography_transform" exec="homography_transform" output="screen">
    </node>

    <node pkg="final_challenge" name="traffic_light_controller" exec="traffic_light_controller" output="screen">
    </node>

    <node pkg="final_challenge" name="traffic_light_color_detector" exec="traffic_light_color_detector" output="screen">
    </node>

    <node pkg="final_challenge" name="yolo_final_challenge" exec="yolo_final_challenge" output="log">
        <param name="image_queue_size" value="1" />
        <param name="inference_period_sec" value="0.25" />
        <param name="publish_annotated_image" value="false" />
        <param name="log_detections" value="false" />
        <param name="stop_after_first_detection" value="false" />
        <param name="lock_target_class" value="parking meter" />
    </node>

</launch>
